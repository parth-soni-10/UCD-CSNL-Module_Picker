# Files in this repo that are NOT part of the published site.
#
# The assets directory is the repository root (same as the Netlify publish
# directory), so everything not listed here would be served. `modules.json`
# stays public deliberately: it is the fallback catalogue data, and the
# Netlify deploy published it too.
.git/
.github/
.gitignore
.freebuff/
.wrangler/
node_modules/

netlify/
tools/

README.md
LICENSE
package.json
server.js
wrangler.toml
worker.js
.assetsignore
# Deploy files. This repository's Pages mirror control config, the scripts that
# deploy it, and the staging output those scripts write (`.pages-bundle/`,
# `.pages-dist/`) are development files: the assets directory is the repository
# root, so anything not listed here would be uploaded and served.
pages/
.pages-bundle/
.pages-dist/
